# Copy this file to local.properties and fill in your keys.
# local.properties is gitignored and never committed.

# Google Maps SDK key (Google Cloud Console > APIs & Services > Credentials)
MAPS_API_KEY=AIza...your_maps_key_here

# Gemini API key (Google AI Studio: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIza...your_gemini_key_here

# Android SDK path (auto-set by Android Studio normally)
# sdk.dir=/Users/you/Library/Android/sdk
